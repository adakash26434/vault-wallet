{
  "manifest_version": 3,
  "name": "Personal Key Wallet",
  "version": "1.0.0",
  "description": "Auto-suggest saved passwords from your Personal Key Wallet on any website.",
  "permissions": ["tabs", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Personal Key Wallet",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
